# Copy to deploy/.env and adjust for the lab host.
HTTP_PORT=8088

POSTGRES_USER=pqcas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pqcas
DATABASE_URL=postgres://pqcas:change-me@postgres:5432/pqcas
REDIS_URL=redis://redis:6379

RUST_LOG=info,sqlx=warn
WORKER_CONCURRENCY=8
MAX_SUBTASKS_PER_TEST=512

# Adapters the worker may dispatch to. Anything not listed renders as 未啟用.
ADAPTERS=openssl=http://adapter-openssl:9100,go=http://adapter-go:9100

# Images: ghcr.io/<owner> and the tag the deploy workflow pins.
REGISTRY=ghcr.io/pqcas
TAG=dev
